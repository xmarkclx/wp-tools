#!/usr/bin/env bash
# 📁 wp-sync-files — Pull a remote WordPress project folder down locally.
#
# 📥 Reads (all from ./sync.env in the current working directory):
#   SSH_HOST=user@host.example.com           # required
#   WP_DIR=/var/www/.../httpdocs             # required (remote project root)
#   SSH_PORT=22                              # optional, default 22
#   SRC_SYNC_DIR=.                           # optional, default . (whole WP_DIR)
#   DEST_SYNC_DIR=.                          # optional, default . (current project)
#   SYNC_EXCLUDE='cache/* *.log'             # optional, space-separated rsync exclude patterns
#
# 🚀 Usage:
#   wp-sync-files                            # transfers immediately (no prompt)
#   wp-sync-files -n                         # dry-run — show what WOULD transfer

set -euo pipefail

COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=wp-tools-lib.sh
source "${COMMAND_DIR}/wp-tools-lib.sh"
wp_tools_set_script_name "wp-sync-files"

PROJECT_DIR="$(wp_project_dir)"
cd "$PROJECT_DIR"

SYNC_ENV_FILE="${PROJECT_DIR}/sync.env"

DRY_RUN=0
while (( $# > 0 )); do
    case "$1" in
        -n|--dry-run) DRY_RUN=1; shift ;;
        -h|--help)    sed -n '1,20p' "$0"; exit 0 ;;
        *)            wp_err "❌ Unknown argument: $1"; exit 1 ;;
    esac
done

[[ -f "$SYNC_ENV_FILE" ]] || { wp_err "❌ Missing $SYNC_ENV_FILE"; exit 1; }

SSH_HOST="$(wp_get_env_value "$SYNC_ENV_FILE" SSH_HOST)" || { wp_err "❌ SSH_HOST missing in sync.env"; exit 1; }
WP_DIR="$(wp_get_env_value "$SYNC_ENV_FILE" WP_DIR)"     || { wp_err "❌ WP_DIR missing in sync.env"; exit 1; }
SSH_PORT="$(wp_get_env_value "$SYNC_ENV_FILE" SSH_PORT 2>/dev/null || true)"
SSH_PORT="${SSH_PORT:-22}"

SRC_SYNC_DIR="$(wp_get_env_value "$SYNC_ENV_FILE" SRC_SYNC_DIR 2>/dev/null || true)"
SRC_SYNC_DIR="${SRC_SYNC_DIR:-.}"
DEST_SYNC_DIR="$(wp_get_env_value "$SYNC_ENV_FILE" DEST_SYNC_DIR 2>/dev/null || true)"
DEST_SYNC_DIR="${DEST_SYNC_DIR:-.}"

SRC_SYNC_DIR="${SRC_SYNC_DIR#/}"; SRC_SYNC_DIR="${SRC_SYNC_DIR%/}"
DEST_SYNC_DIR="${DEST_SYNC_DIR#/}"; DEST_SYNC_DIR="${DEST_SYNC_DIR%/}"

SYNC_EXCLUDE="$(wp_get_env_value "$SYNC_ENV_FILE" SYNC_EXCLUDE 2>/dev/null || true)"

if [[ "$SRC_SYNC_DIR" == "." ]]; then
    REMOTE_PATH="${WP_DIR%/}/"
else
    REMOTE_PATH="${WP_DIR%/}/${SRC_SYNC_DIR}/"
fi

if [[ "$DEST_SYNC_DIR" == "." ]]; then
    LOCAL_PATH="${PROJECT_DIR%/}/"
else
    LOCAL_PATH="${PROJECT_DIR%/}/${DEST_SYNC_DIR}/"
fi

wp_log "🌐 Source: ${SSH_HOST}:${REMOTE_PATH} (port ${SSH_PORT})"
wp_log "📂 Dest  : ${LOCAL_PATH}"

RSYNC_OPTS=(
    -avz
    --human-readable
    --info=progress2,stats2
    --partial
    --append-verify
    --no-perms
    --no-owner
    --no-group
    --exclude=.env
    --exclude=sync.env
    --exclude=backups/
    -e "ssh -p ${SSH_PORT}"
)

if [[ -n "$SYNC_EXCLUDE" ]]; then
    # shellcheck disable=SC2206
    EXCLUDES=( $SYNC_EXCLUDE )
    for pattern in "${EXCLUDES[@]}"; do
        RSYNC_OPTS+=( --exclude="$pattern" )
    done
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
    RSYNC_OPTS+=( --dry-run )
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
    wp_log "🧪 Dry-run mode — nothing will actually be transferred."
fi

mkdir -p "$LOCAL_PATH"

wp_log "🚚 Running rsync …"
rsync "${RSYNC_OPTS[@]}" "${SSH_HOST}:${REMOTE_PATH}" "${LOCAL_PATH}"

if [[ "$DRY_RUN" -eq 1 ]]; then
    wp_ok "✅ Dry-run complete — see the file list above. Re-run without -n to actually transfer."
else
    wp_ok "🎉 Files sync complete: ${SSH_HOST}:${REMOTE_PATH} → ${LOCAL_PATH}"
fi
